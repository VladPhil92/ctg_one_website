# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already in .gitignore.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security entirely.
# NEVER prefix this with NEXT_PUBLIC_ or reference it from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute links in auth emails (e.g. email confirmation redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CTG One Wallet / Privy identity bridge.
# NEXT_PUBLIC_PRIVY_APP_ID identifies the Privy application and is safe for the browser.
# PRIVY_JWT_VERIFICATION_KEY is consumed server-side only to verify ES256 identity tokens;
# provide the Privy identity-token public verification key as PEM or JWK JSON.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_JWT_VERIFICATION_KEY=

# CTG One Wallet / Polygon read layer.
# POLYGON_RPC_URL is server-only and powers read-only native/ERC-20 balance queries.
# CTG_TOKEN_POLYGON_ADDRESS must be independently verified against the production
# deployment record before it is configured; do not copy an address from a client
# bundle merely because it existed in a legacy release.
POLYGON_RPC_URL=
CTG_TOKEN_POLYGON_ADDRESS=

# CTG One Wallet / manual COP top-up rails.
# The approved Bancolombia/Bre-B QR + @grupopisaofood key are immutable public
# display data versioned in source; they do not require a bank API or secret env.
# A conventional bank-transfer option remains fail-closed unless the complete
# public account tuple below is independently verified and configured.
NEXT_PUBLIC_WALLET_BANK_NAME=
NEXT_PUBLIC_WALLET_BANK_ACCOUNT_TYPE=
NEXT_PUBLIC_WALLET_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_WALLET_BANK_ACCOUNT_HOLDER=
NEXT_PUBLIC_WALLET_BANK_ACCOUNT_HOLDER_NIT=

# Future wallet rails remain independently disabled while unset.
NEXT_PUBLIC_WALLET_PSE_NOTE=
NEXT_PUBLIC_WALLET_CRYPTO_NETWORK=
NEXT_PUBLIC_WALLET_CRYPTO_ASSET=
NEXT_PUBLIC_WALLET_CRYPTO_ADDRESS=

# CTG Craft Beer Inversión feature flags (docs/investment/adr/ADR-010).
# All default to false ("off") when unset — fail closed. Enable a capability
# only after its production dependencies, business rule and legal review are ready.
CTG_INVESTMENT_PUBLIC_REGISTRATION_ENABLED=false
CTG_INVESTMENT_PUBLIC_FUNDING_ENABLED=false
CTG_INVESTMENT_PAYMENT_GATEWAY_ENABLED=false
CTG_INVESTMENT_AUTOMATIC_SETTLEMENT_ENABLED=false
CTG_INVESTMENT_AUTOMATIC_WITHDRAWALS_ENABLED=false
CTG_INVESTMENT_KYC_PROVIDER_ENABLED=false
CTG_INVESTMENT_WHATSAPP_NOTIFICATIONS_ENABLED=false

# CTG One AI model gateway — all provider credentials remain server-only.
# CTG_AI_PROVIDER is intentionally allowlisted by the gateway; unsupported values fail closed.
CTG_AI_PROVIDER=openai
CTG_AI_CONFIG_VERSION=ctg-knowledge-v0.2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RESPONSE_MODEL=gpt-5-mini
# Bounded resilience policy. Runtime clamps timeout to 1–60 seconds and attempts to 1–3.
OPENAI_REQUEST_TIMEOUT_MS=15000
OPENAI_MAX_ATTEMPTS=2

# Nvet Care dashboard (docs/nvetcareapp/adr/ADR-001/ADR-002). Base URL of
# the standalone NestJS backend the BFF routes under
# src/app/api/nvetcareapp/** proxy to — never exposed to the browser.
CTG_NVETCARE_API_URL=